# Copy these into your shell or Render's environment settings. Never commit real values.
NODE_ENV=development
PORT=3000
# Public site URL, used for canonical links and the sitemap (no trailing slash).
SITE_URL=http://localhost:3000
# Where JSON data lives. On Render set this to the persistent disk mount path, e.g. /var/data.
# If unset, data lives in ./data and the app reports "temporary demo storage".
DATA_DIR=
# Behind Render's proxy, read the real client IP from X-Forwarded-For (used by rate limiting).
# Automatically on when NODE_ENV=production.
TRUST_PROXY=
# Seconds between simulated order status steps (confirmed, preparing, ...). Default 45.
DEMO_ORDER_PACE_SECONDS=45
